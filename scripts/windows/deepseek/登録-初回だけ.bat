@echo off
chcp 932 >nul 2>&1
:: ============================================================
:: 登録-初回だけ.bat
:: DeepSeek の API キーを Windows ユーザー領域に保存する（初回1回だけ）
:: ------------------------------------------------------------
:: ・このファイルには API キーは書かれていません。
::   実行時に入力した値を setx で「あなたの Windows ユーザー専用」の
::   場所に保存します（毎日使う起動ファイルに平文で残しません）。
:: ・暗号化ではなく、本人のアカウントからは読める状態です。
::   漏えい対策は「少額チャージ + 授業後にキー削除」で守ります。
:: ============================================================
echo.
echo DeepSeek の API キーを登録します。
echo （次の行で右クリック貼り付け → Enter）
echo.
set /p KEY=APIキー:
if "%KEY%"=="" (
    echo.
    echo 何も入力されませんでした。中止します。
    pause
    exit /b 1
)
setx ANTHROPIC_AUTH_TOKEN "%KEY%" >nul
echo.
echo 登録できました。このウィンドウは閉じてOKです。
echo （次に「起動-Claude-DeepSeek.bat」を新しく開くとキーが反映されます）
pause
