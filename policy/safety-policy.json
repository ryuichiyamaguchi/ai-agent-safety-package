{
  "packageVersion": "1.12.0",
  "hookApiVersion": "1",
  "defaultWorkspaceName": "safe-workspace",
  "_comment_blockedDomains": "プロンプトインジェクション経由でのデータ流出を防ぐため、匿名アップロード系・gist 系をブロック。blockedDomains は allowedDomains より優先される。WebFetch は GET 専用・読み取り目的のみ想定。",
  "allowedDomains": [
    "developers.openai.com",
    "platform.openai.com",
    "docs.anthropic.com",
    "code.claude.com",
    "github.com",
    "api.github.com",
    "raw.githubusercontent.com",
    "objects.githubusercontent.com",
    "docs.github.com",
    "gemini.google.com",
    "ai.google.dev",
    "cloud.google.com",
    "registry.npmjs.org",
    "pypi.org",
    "files.pythonhosted.org"
  ],
  "blockedDomains": [
    "gist.github.com",
    "gist.githubusercontent.com",
    "*.pages.dev",
    "*.workers.dev",
    "pastebin.com",
    "hastebin.com",
    "0x0.st",
    "transfer.sh",
    "file.io",
    "anonfiles.com"
  ],
  "protectedPathRegex": [
    "(^|[\\\\/])[.]env([.].*)?$",
    "(^|[\\\\/])[.]ssh([\\\\/]|$)",
    "(^|[\\\\/])[.]aws([\\\\/]|$)",
    "(^|[\\\\/])[.]azure([\\\\/]|$)",
    "(^|[\\\\/])[.]gnupg([\\\\/]|$)",
    "(^|[\\\\/])[.]kube([\\\\/]|$)",
    "(^|[\\\\/])[.]docker([\\\\/]|$)",
    "(^|[\\\\/])[.]config[\\\\/]gcloud([\\\\/]|$)",
    "(^|[\\\\/])secrets?([\\\\/]|$)",
    "(^|[\\\\/])creds?([\\\\/]|$)",
    "(^|[\\\\/])id[_-]rsa$",
    "(^|[\\\\/])id[_-]ed25519$",
    "(^|[\\\\/])known[_-]hosts$",
    "(^|[\\\\/])[.]npmrc$",
    "(^|[\\\\/])[.]pypirc$"
  ],
  "secretRegex": [
    { "name": "OpenAI API key", "pattern": "sk-(proj-)?[A-Za-z0-9_\\-]{20,}" },
    { "name": "Anthropic API key", "pattern": "sk-ant-[A-Za-z0-9_\\-]{20,}" },
    { "name": "Google API key", "pattern": "AIza[0-9A-Za-z_\\-]{25,}" },
    { "name": "AWS access key", "pattern": "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b" },
    { "name": "GitHub token", "pattern": "\\bgh[pousr]_[A-Za-z0-9_]{36,255}\\b" },
    { "name": "Slack token", "pattern": "\\bxox[baprs]-[A-Za-z0-9\\-]{10,}\\b" },
    { "name": "JWT", "pattern": "\\beyJ[A-Za-z0-9_\\-]+\\.[A-Za-z0-9_\\-]+\\.[A-Za-z0-9_\\-]+\\b" },
    { "name": "Private key block", "pattern": "-----BEGIN (RSA |DSA |EC |OPENSSH |PGP )?PRIVATE KEY-----" },
    { "name": "Generic sensitive assignment", "pattern": "(?i)(api[_-]?key|secret|token|password|passwd|pwd)\\s*[:=]\\s*['\\\"]?[A-Za-z0-9_\\.\\-\\/+=]{12,}" }
  ],
  "_comment_outputSecretRegex": "AI の出力(Stop/PostToolUse=guard-post-output)を走査する専用パターン集。secretRegex から『Generic sensitive assignment』だけを除いたコピー。理由: 汎用の `api_key: \"...\"` 代入パターンは config 例・解説文など正規の技術出力に大量に一致し、API キー等を説明するたびに回答全体がブロックされ実務で使い物にならなくなる(over-blocking)。本物のキー書式(OpenAI/Anthropic/Google/AWS/GitHub/Slack/JWT/秘密鍵ブロック)だけを出力側でも止める。入力側(guard-bash/guard-write の has_sensitive_text/Find-SecretMatch)は引き続き secretRegex 全体を使い、deny floor は不変。",
  "outputSecretRegex": [
    { "name": "OpenAI API key", "pattern": "sk-(proj-)?[A-Za-z0-9_\\-]{20,}" },
    { "name": "Anthropic API key", "pattern": "sk-ant-[A-Za-z0-9_\\-]{20,}" },
    { "name": "Google API key", "pattern": "AIza[0-9A-Za-z_\\-]{25,}" },
    { "name": "AWS access key", "pattern": "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b" },
    { "name": "GitHub token", "pattern": "\\bgh[pousr]_[A-Za-z0-9_]{36,255}\\b" },
    { "name": "Slack token", "pattern": "\\bxox[baprs]-[A-Za-z0-9\\-]{10,}\\b" },
    { "name": "JWT", "pattern": "\\beyJ[A-Za-z0-9_\\-]+\\.[A-Za-z0-9_\\-]+\\.[A-Za-z0-9_\\-]+\\b" },
    { "name": "Private key block", "pattern": "-----BEGIN (RSA |DSA |EC |OPENSSH |PGP )?PRIVATE KEY-----" }
  ],
  "_comment_dangerousCommand": "v1.12.0 教室プロファイル: 方針を『広めに deny』から『不可逆破壊・リモートコード実行・秘密流出だけを決定的 deny し、それ以外は各 CLI のネイティブ承認 / 2 鍵 AI 判定に委ねる』に転換（教室 PC には重要データが無い前提で、エージェンティックループの体験を優先する）。curl/wget/ssh/env 等の一律 deny は撤廃。残すのは (a) .env 等の秘密読み取り (b) 再帰削除(rm -r/-rf/--recursive・Remove-Item -Recurse 等、force の有無を問わない) / format / diskpart / mkfs / dd of=/dev/ 等の不可逆破壊 (c) fork bomb (d) curl|sh・iex(irm …)・$(curl …) 型のリモートコード実行（プロンプトインジェクションの主経路） (e) 匿名アップロードサイトへのシェル経由送信 (f) nc/ncat/netcat（教室で正当用途が無い生ソケット送受信）。git push は deny から外して各 CLI の ask 層（settings.json / 2 鍵判定の決定的 ask）へ移管。npm publish 等の公開系は deny のまま。",
  "dangerousCommandRegex": [
    "(?i)\\b(cat|type|Get-Content|gc|more|less)\\b.*(^|\\s|[\\\\/])[.]env([.].*)?(\\s|$)",
    "(?i)\\bpython(3)?\\b.*open\\s*\\(\\s*['\\\"][^'\\\"]*[.]env",
    "(?i)\\b(node|ruby|perl|php)\\b.*[.]env",
    "(?i)\\brm\\s+(-[A-Za-z]*r[A-Za-z]*|--recursive|-[A-Za-z]+\\s+-[A-Za-z]*r[A-Za-z]*)\\b",
    "(?i)\\bRemove-Item\\b.*(-Recurse\\b|\\s-r\\b)",
    "(?i)\\b(ri|rmdir)\\b.*(-Recurse\\b|\\s-r\\b)",
    "(?i)\\b(del|erase|rd|rmdir)\\b.*\\s/(s|q)\\b",
    "(?i)\\b(format|diskpart|cipher\\s+/w)\\b",
    "(?i)(\\bmkfs([.][a-z0-9]+)?\\b|\\bdd\\b.*\\bof=/dev/|\\bshred\\b)",
    "(?i)\\bchmod\\s+777\\b",
    "(?i)\\b(nc|ncat|netcat)\\b",
    ":\\(\\)\\s*\\{\\s*:\\s*\\|\\s*:\\s*&\\s*\\}\\s*;\\s*:",
    "(?i)\\b(curl|wget|iwr|irm|Invoke-WebRequest|Invoke-RestMethod)\\b.*\\|.*\\b(sh|bash|zsh|python3?|node|ruby|perl|php|pwsh|powershell|iex)\\b",
    "(?i)\\b(iex|Invoke-Expression)\\b.*\\b(irm|iwr|Invoke-RestMethod|Invoke-WebRequest)\\b",
    "(?i)(\\$\\(|<\\()\\s*(curl|wget)\\b",
    "(?i)\\b(curl|wget|iwr|irm|Invoke-WebRequest|Invoke-RestMethod)\\b.*(pastebin[.]com|hastebin[.]com|0x0[.]st|transfer[.]sh|file[.]io|anonfiles[.]com|gist[.]github)",
    "(?i)\\b(npm\\s+publish|twine\\s+upload|gem\\s+push)\\b"
  ],
  "generatedCodeDenyRegex": [
    "(?i)open\\s*\\(\\s*['\\\"][^'\\\"]*[.]env",
    "(?i)(readFileSync|read_file|Get-Content|File[.]read|Path\\().*[.]env",
    "(?i)(subprocess|child_process|ProcessStartInfo).*[.]env"
  ],
  "allowShellNetwork": true,
  "allowWorkspaceOutsideWrites": false,
  "maxHookInputBytes": 262144
}
