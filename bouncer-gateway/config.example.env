# Bouncer only listens on loopback by default.
BOUNCER_HOST=127.0.0.1
BOUNCER_PORT=8787

# LM Studio OpenAI-compatible local API.
BOUNCER_LM_STUDIO_URL=http://127.0.0.1:1234/v1
BOUNCER_LOCAL_MODEL=bouncer-gemma
BOUNCER_AI_TIMEOUT=120
BOUNCER_AI_MODE=balanced

# Fail closed when Gemma is unavailable and hold review decisions by default.
BOUNCER_AI_FAILURE_MODE=block
BOUNCER_REVIEW_MODE=block

# Anthropic Messages upstream.
BOUNCER_ANTHROPIC_UPSTREAM=https://api.anthropic.com
BOUNCER_UPSTREAM_TIMEOUT=600
# Keep disabled unless testing against a trusted custom gateway.
BOUNCER_ALLOW_CUSTOM_UPSTREAM=0
