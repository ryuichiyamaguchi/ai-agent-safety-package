{
  "hooks": {
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .ai-safety\\hooks\\windows\\guard-prompt.ps1"
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .ai-safety\\hooks\\windows\\guard-bash.ps1"
        }
      ]
    },
    {
      "matcher": "Write|Edit|MultiEdit|apply_patch",
      "hooks": [
        {
          "type": "command",
          "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .ai-safety\\hooks\\windows\\guard-write.ps1"
        }
      ]
    },
    {
      "matcher": "WebFetch|web_fetch",
      "hooks": [
        {
          "type": "command",
          "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .ai-safety\\hooks\\windows\\guard-webfetch.ps1"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Bash|Read|WebFetch|web_fetch",
      "hooks": [
        {
          "type": "command",
          "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .ai-safety\\hooks\\windows\\guard-post-output.ps1"
        }
      ]
    }
  ]
  }
}
