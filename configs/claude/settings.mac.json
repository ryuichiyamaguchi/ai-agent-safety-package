{
  "env": {
    "AI_SAFE_ENGINE": "claude",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "cleanupPeriodDays": 120,
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Bash(ls*)",
      "Bash(pwd*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(tree*)",
      "Bash(which *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(df*)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(date*)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(env*)",
      "Bash(printenv*)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(tar *)",
      "Bash(unzip *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git stash*)",
      "Bash(git clone*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(gem install*)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(python3 -m pytest*)",
      "Bash(pytest*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch(domain:developers.openai.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:gemini.google.com)",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:cloud.google.com)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(git restore*)",
      "Bash(git rebase*)",
      "Bash(sudo *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(npm publish*)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:gist.githubusercontent.com)",
      "WebFetch(domain:pastebin.com)",
      "WebFetch(domain:hastebin.com)",
      "WebFetch(domain:0x0.st)",
      "WebFetch(domain:transfer.sh)",
      "WebFetch(domain:file.io)",
      "WebFetch(domain:anonfiles.com)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.azure/**)",
      "Read(**/.kube/**)",
      "Read(**/.config/gcloud/**)",
      "Read(**/.docker/config.json)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.ai-safety/**)",
      "Edit(**/.ai-safety/**)",
      "Read(**/.deepseek-claude/**)",
      "Edit(**/.deepseek-claude/**)"
    ]
  },
  "_comment_sandbox": "Claude Code 純正サンドボックス（macOS / Linux / WSL2 のみ。ネイティブ Windows は公式非対応なので settings.windows.json には書かない）。macOS では /usr/bin/sandbox-exec（Seatbelt）が OS カーネル側で境界を強制する。目的は『縛りを増やすこと』ではなく『縛りを減らすこと』: autoAllowBashIfSandboxed により、サンドボックスの中で完結するコマンドは確認ダイアログ無しで実行される（＝実用性が上がる）。⚠️ 重大な性質: サンドボックスが止めるのは『作業フォルダの外への書き込み』と『許可外ドメインへの通信』だけで、読み取りは設計上止まらない（Seatbelt プロファイルに (allow file-read*) が入っている。実測でホーム直下のファイルと /etc/hosts が読めた）。したがって秘密の読み取りを止めている hook（guard-write.sh / guard-webfetch.sh / guard-post-output.sh / guard-bash.sh）は 1 本も外していない。とくに guard-write は Write/Edit ツール（サンドボックスは Bash 子プロセスにしか効かない）、guard-webfetch は WebFetch（in-process ツールなので allowedDomains の対象外）、guard-post-output は出力側の最後の砦。設定していないキーについて: failIfUnavailable / strictAllowlist / allowUnsandboxedCommands は入れていない。failIfUnavailable=true はサンドボックスが起動できない環境で Claude 自体が起動しなくなり受講者が詰むため（起動できなかった場合は v1.16.0 と同じ hook のみの守りに落ちるだけで、無防備にはならない）。strictAllowlist / allowUnsandboxedCommands はプロジェクト設定から効かない可能性が公式に示唆されており、効かない設定を書いて『効いているつもり』を作らないため。",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "statsig.anthropic.com",
        "docs.anthropic.com",
        "code.claude.com",
        "console.anthropic.com",
        "api.deepseek.com",
        "platform.deepseek.com",
        "generativelanguage.googleapis.com",
        "ai.google.dev",
        "aistudio.google.com",
        "gemini.google.com",
        "cloud.google.com",
        "image.pollinations.ai",
        "pollinations.ai",
        "mcp.buffer.com",
        "developers.openai.com",
        "platform.openai.com",
        "api.openai.com",
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "codeload.github.com",
        "docs.github.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ],
      "deniedDomains": [
        "gist.github.com",
        "gist.githubusercontent.com",
        "*.pages.dev",
        "*.workers.dev",
        "pastebin.com",
        "hastebin.com",
        "0x0.st",
        "transfer.sh",
        "file.io",
        "anonfiles.com"
      ]
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-prompt.sh\"; if [ ! -x \"$p\" ]; then echo \"AI Safety hook missing: $p\" >&2; exit 2; fi; \"$p\""
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-observe.sh\"; if [ ! -x \"$p\" ]; then exit 0; fi; \"$p\"; exit 0"
            ]
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-bash.sh\"; if [ ! -x \"$p\" ]; then echo \"AI Safety hook missing: $p\" >&2; exit 2; fi; \"$p\""
            ]
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-write.sh\"; if [ ! -x \"$p\" ]; then echo \"AI Safety hook missing: $p\" >&2; exit 2; fi; \"$p\""
            ]
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-webfetch.sh\"; if [ ! -x \"$p\" ]; then echo \"AI Safety hook missing: $p\" >&2; exit 2; fi; \"$p\""
            ]
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-observe.sh\"; if [ ! -x \"$p\" ]; then exit 0; fi; \"$p\"; exit 0"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-post-output.sh\"; if [ ! -x \"$p\" ]; then echo \"AI Safety hook missing: $p\" >&2; exit 2; fi; \"$p\""
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-post-output.sh\"; if [ ! -x \"$p\" ]; then echo \"AI Safety hook missing: $p\" >&2; exit 2; fi; \"$p\""
            ]
          }
        ]
      }
    ]
  }
}
