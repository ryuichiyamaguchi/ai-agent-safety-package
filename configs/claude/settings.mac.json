{
  "env": {
    "AI_SAFE_ENGINE": "claude",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "cleanupPeriodDays": 120,
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(./**)",
      "LS(./**)",
      "Glob(./**)",
      "Grep(./**)",
      "Edit(./**)",
      "Write(./**)",
      "MultiEdit(./**)",
      "Bash(ls*)",
      "Bash(pwd*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(tree*)",
      "Bash(which *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(df*)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(date*)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(env*)",
      "Bash(printenv*)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(tar *)",
      "Bash(unzip *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git stash*)",
      "Bash(git clone*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(gem install*)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(python3 -m pytest*)",
      "Bash(pytest*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch(domain:developers.openai.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:gemini.google.com)",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:cloud.google.com)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(git restore*)",
      "Bash(git rebase*)",
      "Bash(sudo *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(npm publish*)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:gist.githubusercontent.com)",
      "WebFetch(domain:pastebin.com)",
      "WebFetch(domain:hastebin.com)",
      "WebFetch(domain:0x0.st)",
      "WebFetch(domain:transfer.sh)",
      "WebFetch(domain:file.io)",
      "WebFetch(domain:anonfiles.com)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/.ssh/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.azure/**)",
      "Read(**/.kube/**)",
      "Read(**/.config/gcloud/**)",
      "Read(**/.docker/config.json)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-prompt.sh\"; if [ ! -x \"$p\" ]; then echo \"AI Safety hook missing: $p\" >&2; exit 2; fi; \"$p\""
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-observe.sh\"; if [ ! -x \"$p\" ]; then exit 0; fi; \"$p\"; exit 0"
            ]
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-bash.sh\"; if [ ! -x \"$p\" ]; then echo \"AI Safety hook missing: $p\" >&2; exit 2; fi; \"$p\""
            ]
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-write.sh\"; if [ ! -x \"$p\" ]; then echo \"AI Safety hook missing: $p\" >&2; exit 2; fi; \"$p\""
            ]
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-webfetch.sh\"; if [ ! -x \"$p\" ]; then echo \"AI Safety hook missing: $p\" >&2; exit 2; fi; \"$p\""
            ]
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-observe.sh\"; if [ ! -x \"$p\" ]; then exit 0; fi; \"$p\"; exit 0"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-post-output.sh\"; if [ ! -x \"$p\" ]; then echo \"AI Safety hook missing: $p\" >&2; exit 2; fi; \"$p\""
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash",
            "args": [
              "-lc",
              "p=\"${CLAUDE_PROJECT_DIR}/.ai-safety/hooks/macos/guard-post-output.sh\"; if [ ! -x \"$p\" ]; then echo \"AI Safety hook missing: $p\" >&2; exit 2; fi; \"$p\""
            ]
          }
        ]
      }
    ]
  }
}
